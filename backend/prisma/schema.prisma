// Event Registration System — data model
// See docs/ARCHITECTURE.md §6 for design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(PARTICIPANT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
  events        Event[]
}

model Event {
  id             String         @id @default(cuid())
  title          String
  description    String?
  startsAt       DateTime
  capacity       Int
  reminderSentAt DateTime? // coarse guard; per-participant guard is EmailLog
  // Owning organizer. Nullable for backward compat with pre-ownership events.
  organizer      User?          @relation(fields: [organizerId], references: [id])
  organizerId    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  registrations  Registration[]
  emailLogs      EmailLog[]

  @@index([organizerId]) // "my events" lookups
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

model Registration {
  id          String             @id @default(cuid())
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  email       String
  // Optional link to the participant account. Nullable for backward compat with
  // pre-account registrations; email remains the identity key for concurrency.
  user        User?              @relation(fields: [userId], references: [id])
  userId      String?
  status      RegistrationStatus
  waitlistPos Int? // FIFO ordering for promotion (null unless WAITLISTED)
  checkedInAt DateTime? // set once at check-in
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  ticket      Ticket?
  emailLogs   EmailLog[]

  @@unique([eventId, email]) // enforces idempotent registration (req. 1)
  @@index([eventId, status]) // fast capacity counts & waitlist ordering
  @@index([userId]) // "my registrations" lookups
}

model Ticket {
  id             String       @id @default(cuid())
  code           String       @unique // the unique ticket code
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String       @unique
  createdAt      DateTime     @default(now())
}

enum EmailType {
  REGISTRATION_TICKET
  WAITLIST_PROMOTED
  EVENT_REMINDER
  EVENT_RESCHEDULED
}

// Mock email outbox + idempotency ledger. A row IS the record of a (would-be)
// sent email; the unique deduplicationKey makes recording exactly-once.
model EmailLog {
  id               String       @id @default(cuid())
  recipient        String
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId          String
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId   String
  type             EmailType
  // Deterministic per logical notification, e.g. "registration-ticket:{regId}",
  // "waitlist-promoted:{regId}", "event-reminder:{eventId}:{regId}".
  deduplicationKey String       @unique // exactly-once guard (reqs. 5, 6)
  payload          Json
  sentAt           DateTime     @default(now())

  @@index([eventId])
  @@index([registrationId])
}
