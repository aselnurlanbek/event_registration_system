# Server
PORT=5050

# CORS — the frontend origin (Vite dev server default)
CORS_ORIGIN=http://localhost:5173

# Database
# Local homebrew Postgres (trust auth): postgresql://<user>@localhost:5432/event_registration?schema=public
# Docker Postgres (see docker-compose.yml):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_registration?schema=public"
# Auth (set a strong secret in production)
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=1d
